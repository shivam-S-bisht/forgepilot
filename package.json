{
  "name": "@shivam-s-bisht/forgepilot",
  "version": "0.1.31",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "bin": {
    "forgepilot": "./dist/index.js",
    "forgepilot-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "start": "node ./dist/index.js",
    "dev": "tsup --watch",
    "link": "npm run build && npm link",
    "release": "standard-version",
    "release:first": "standard-version --first-release",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.6.2",
    "sherpa-onnx-node": "^1.12.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.3.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
